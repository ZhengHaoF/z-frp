# z-frp 前置 Caddy 示例：一条 HTTP 隧道对应一个完整域名。
# 每个域名的 A/CNAME 记录都要指向本机；在此列出站点名，Caddy 自动签证书。
# 新增域名：加 DNS 记录 + 在下面的站点地址里加上它 + reload caddy。
# 数据库 TCP 不走 Caddy，由 frps 直接监听 remotePort（需安全组放行）。

a.b.com, c.b.com {
	# 单域名证书走 HTTP-01 即可，不需要泛域名 DNS challenge
	tls {
		# 如需指定 ACME 邮箱，取消注释并替换
		# email admin@example.com
	}

	# 客户端隧道 WebSocket
	@ws path /_frp
	handle @ws {
		reverse_proxy 127.0.0.1:7000
	}

	# 其余按 Host 头交给 frps HTTP 入口路由到对应隧道
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

# dashboard 单独一个域名，basic auth 保护，不要公网裸奔
dash.b.com {
	tls
	basicauth {
		# 用 caddy hash-password 生成
		admin $2a$14$REPLACE_WITH_CADDY_HASHED_PASSWORD
	}
	reverse_proxy 127.0.0.1:7500
}
