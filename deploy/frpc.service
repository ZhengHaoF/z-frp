[Unit]
Description=z-frp client (frpc)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/z-frp-client
# 把 <KEY> 换成 tunnel create 输出的 key；跨机器时按需加 -local
ExecStart=/usr/bin/node /opt/z-frp-client/packages/frpc/dist/index.js -key <KEY> -server wss://frp.example.com/_frp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
